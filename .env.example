# Deye Solar Optimizer v3.1.0
# Copy to /etc/deye-solar-optimizer/deye.env and edit.
# NEVER commit the real deye.env. This example intentionally contains no credentials.

# ---------- Deye OpenAPI ----------
DEYE_APP_ID="YOUR_APP_ID"
DEYE_APP_SECRET="YOUR_APP_SECRET"
DEYE_LOGIN="you@example.com"
DEYE_PASSWORD="YOUR_DEYE_PASSWORD"
DEYE_BASE_URL="https://eu1-developer.deyecloud.com/v1.0"
DEYE_STATION_ID=0
DEYE_INVERTER_SN="YOUR_INVERTER_SN"

# ---------- Site ----------
SITE_LATITUDE=0.0
SITE_LONGITUDE=0.0
SITE_TIMEZONE="Etc/UTC"

# Quick operating strategy: conservative | risky | max-export | save | economic
STRATEGY_ACTIVE="conservative"

# ---------- Battery ----------
BATTERY_EFFECTIVE_KWH=15.0
BATTERY_SOC_FLOOR_PCT=15.0
BATTERY_DAY_TARGET_SOC_PCT=96.0
BATTERY_MAINTENANCE_TARGET_SOC_PCT=100.0
BATTERY_MAINTENANCE_INTERVAL_DAYS=30
BATTERY_FULL_SOC_THRESHOLD_PCT=99.5

# ---------- Grid/export ----------
# SAFETY: this is the absolute ceiling the software will ever request.
GRID_EXPORT_HARD_LIMIT_W=1000
GRID_DAY_EXPORT_W=1000

# ---------- House/inverter model ----------
LOAD_BASE_HOUSE_W=115
LOAD_SYSTEM_OVERHEAD_W=130
LOAD_FORECAST_LEARNING_DAYS=14
LOAD_FORECAST_MIN_LEARNING_DAYS=3
LOAD_FORECAST_FALLBACK_HOUSE_W=230
LOAD_FORECAST_MIN_HOUSE_W=100
LOAD_FORECAST_MAX_HOUSE_W=600
LOAD_FORECAST_SUBTRACT_SCHEDULED_LOADS=true

# ---------- PV model ----------
PV_PERFORMANCE_RATIO=0.82
PV_WAKE_THRESHOLD_W=30
PV_USEFUL_THRESHOLD_W=250
PV_WAKEUP_BIAS_MINUTES=15
# Open-Meteo convention used by this project: 0=S, -90=E, +90=W, +/-180=N.
# Any number of arrays can be described here.
PV_ARRAYS_JSON='[{"name":"south_roof","kwp":10.0,"tilt_deg":35,"azimuth_deg":0}]'

# ---------- Morning/night ----------
NIGHT_MORNING_SURPLUS_THRESHOLD_W=350
NIGHT_SUSTAINED_MINUTES=30
NIGHT_FLOOR_LEAD_MINUTES=10

# ---------- Scheduled flexible loads ----------
# These are forecast/planning inputs only. v3 does not switch appliances itself.
WATER_HEATER_ENABLED=false
WATER_HEATER_TIME="10:00"
WATER_HEATER_POWER_W=2000
WATER_HEATER_DURATION_MINUTES=90
# Leave blank to derive from POWER_W * DURATION. Set explicitly if measured energy is better.
WATER_HEATER_ENERGY_KWH=3.0

COOKER_ENABLED=false
COOKER_TIME="18:00"
COOKER_POWER_W=2000
COOKER_DURATION_MINUTES=45
COOKER_ENERGY_KWH=

# ---------- Forecast uncertainty ----------
FORECAST_DEFAULT_SAFE_FACTOR=0.80
FORECAST_LEARNING_DAYS=14
FORECAST_MIN_LEARNING_DAYS=5
FORECAST_LOWER_QUANTILE=0.20
FORECAST_MIN_FACTOR=0.60
FORECAST_MAX_FACTOR=1.05

# ---------- Day strategy ----------
DAY_AUTO_EXPORT_BUDGET_CONTROL=true
DAY_CHARGE_EFFICIENCY=0.91
DAY_EXPORT_SUPPORT_RESERVE_KWH=1.5
DAY_MAX_TELEMETRY_AGE_MINUTES=15
DAY_MORNING_RESTORE_WINDOW_MINUTES=90
DAY_MAX_BUDGET_WRITES_PER_DAY=2
# Closed-loop curtailment guard. When the battery is at/above this SOC, is no longer
# absorbing (charge power below the threshold) and PV is still producing, the sell cap
# is reopened to the legal limit regardless of the forecast-derived budget: unexported
# surplus in that state is curtailed and lost. Requires fresh telemetry.
DAY_CURTAILMENT_OVERRIDE_ENABLED=true
DAY_CURTAILMENT_OVERRIDE_SOC_PCT=98.0
DAY_CURTAILMENT_OVERRIDE_CHARGE_W=300.0
DAY_CURTAILMENT_OVERRIDE_MIN_PV_W=100.0

# Intraday forecast-bias corrector. The historical safe factor says how wrong this
# forecast usually is; it says nothing about whether TODAY is running above or below
# its own curve. This compares the inverter's daily production counter against the
# forecast integrated to the same sample time, and applies the ratio as a correction
# to the remaining forecast. The safe factor is still applied on top, so correcting
# for today's conditions never spends the safety margin.
# The trailing window is preferred; it falls back to the whole day so far. The
# correction is shrunk toward 1.0 until TRUST_KWH of forecast energy has elapsed.
DAY_INTRADAY_BIAS_ENABLED=true
DAY_INTRADAY_BIAS_WINDOW_HOURS=3.0
DAY_INTRADAY_BIAS_MIN_FORECAST_KWH=1.0
DAY_INTRADAY_BIAS_TRUST_KWH=3.0
DAY_INTRADAY_BIAS_MIN=0.40
DAY_INTRADAY_BIAS_MAX=1.60

# Load-scaled strategy reserve. The reserve is held as a number of hours of measured
# house draw rather than a fixed slab of kWh: 2.5 kWh is roughly seven hours of cover
# in summer but barely three once heating raises the base load, so a fixed setting is
# over-cautious in July and thin in January. The per-strategy hours live in
# strategy_presets.py as hours of cover; the fixed reserve_kwh remains as a fallback.
# Set false to restore the fixed per-strategy kWh.
DAY_LOAD_SCALED_RESERVE_ENABLED=true
DAY_RESERVE_MIN_KWH=0.5
DAY_RESERVE_MAX_KWH=6.0

# ---------- Telemetry/cloud health ----------
TELEMETRY_STALE_WARNING_MINUTES=10
TELEMETRY_CLOUD_OFFLINE_MINUTES=20

# ---------- Control safety ----------
CONTROL_LOOP_SECONDS=60
CONTROL_FORECAST_REFRESH_MINUTES=60
CONTROL_SOC_FRESH_MINUTES=5
CONTROL_SOC_ESTIMATE_MAX_MINUTES=75
CONTROL_SOC_ESTIMATE_MAX_PV_W=100
CONTROL_SOC_ESTIMATE_MAX_DELTA_PCT=15
CONTROL_MAX_TELEMETRY_AGE_MINUTES=90
CONTROL_OFFLINE_RETRY_SECONDS=60
CONTROL_UNCERTAIN_SUBMIT_GUARD_MINUTES=120
CONTROL_WRITE_API="power_update"
CONTROL_ORDER_STATUS_POLL_SECONDS=15
CONTROL_FAILED_ORDER_RETRY_MINUTES=15
# Deye device-level order rejections (error 540) are not transient; retrying them on the
# normal cadence only burns the daily submission ceiling.
CONTROL_DEVICE_REJECT_RETRY_MINUTES=45
CONTROL_DEVICE_REJECT_ERROR_CODES=540
CONTROL_WRITE_STEP_W=100
CONTROL_MIN_WRITE_DELTA_W=200
CONTROL_MIN_WRITE_INTERVAL_MINUTES=120

# v3 write accounting:
# - only confirmed status=666 changes consume the normal successful-write budget;
# - confirmed status=500 failures do NOT consume it;
# - all positive-orderId submissions still count against a separate anti-storm budget;
# - one fifth successful write is allowed only for a large change (default >=500W).
CONTROL_MAX_SUCCESSFUL_WRITES_PER_DAY=4
CONTROL_BONUS_WRITE_ENABLED=true
CONTROL_BONUS_WRITE_DELTA_W=500
CONTROL_MAX_SUCCESSFUL_WRITES_WITH_BONUS=5
CONTROL_MAX_ORDER_SUBMISSIONS_PER_DAY=8

CONTROL_MAX_NIGHT_CORRECTIONS=1
CONTROL_SOC_CORRECTION_THRESHOLD_PCT=5.0
CONTROL_NIGHT_START_MINUTES_BEFORE_SUNSET=30

# Fresh installs should start observation-only. Change only after commissioning.
CONTROL_DRY_RUN=true

# ---------- Local files ----------
LOGGING_STATE_DB="/var/lib/deye-solar-optimizer/state.db"
LOGGING_JSONL="/var/lib/deye-solar-optimizer/events.jsonl"
LOGGING_BUNDLE_DIR="/var/lib/deye-solar-optimizer/exports"

# ---------- Probabilistic forecast learning (v3.1+) ----------
# The learner stays dormant until enough completed days exist in a comparable lead-time
# bucket (day-ahead, 06-09, 09-12, etc.). Then P10/P20/P50/P80/P90 multipliers are
# learned from actual_daily_PV / forecast_daily_PV history.
FORECAST_PROBABILISTIC_ENABLED=true
FORECAST_PROBABILISTIC_MIN_DAYS=10
FORECAST_PROBABILISTIC_LEARNING_DAYS=45
FORECAST_PROBABILISTIC_QUANTILES="0.10,0.20,0.50,0.80,0.90"

# ---------- Adaptive morning handoff learning ----------
# Requires v3.1 forecast-point history. Before MIN_DAYS it applies 0 learned bias.
MORNING_LEARNING_ENABLED=true
MORNING_LEARNING_MIN_DAYS=7
MORNING_LEARNING_DAYS=30
MORNING_LEARNING_MAX_ABS_MINUTES=45

# ---------- Read-only analytics/dashboard ----------
ANALYTICS_ENABLED=true
# Safer default: only local machine. Reverse-proxy explicitly if remote access is wanted.
ANALYTICS_BIND="127.0.0.1"
ANALYTICS_PORT=8787
ANALYTICS_HISTORY_DAYS=30
ANALYTICS_REPLAY_CAPS_W="0,300,500,800,1000"
ANALYTICS_BATTERY_CHARGE_EFFICIENCY=0.91
ANALYTICS_BATTERY_DISCHARGE_EFFICIENCY=0.95
ANALYTICS_BATTERY_MAX_CHARGE_W=10000
ANALYTICS_BATTERY_MAX_DISCHARGE_W=10000
ANALYTICS_BATTERY_SOC_CEILING_PCT=100
ANALYTICS_ORACLE_SOC_STEP_PCT=0.5
ANALYTICS_ORACLE_EXPORT_STEP_W=100
ANALYTICS_CURTAILMENT_SOC_THRESHOLD_PCT=98
ANALYTICS_CURTAILMENT_EXPORT_MARGIN_W=100
ANALYTICS_CURTAILMENT_MIN_GAP_W=300
# Optional mapping for per-MPPT learning, e.g. {"PV1":"east","PV2":"west"}.
# Array names must match PV_ARRAYS_JSON. Leave {} until physically identified.
ANALYTICS_MPPT_MAP_JSON='{}'

# ---------- Economic analytics ----------
# Used for replay/dashboard scoring only in v3.1; it never changes inverter control.
ECONOMIC_IMPORT_EUR_KWH=0.25
ECONOMIC_EXPORT_EUR_KWH=0.00
# Approximate wear cost per kWh discharged. Leave 0 if you do not want to monetize wear.
ECONOMIC_BATTERY_WEAR_EUR_KWH=0.00
