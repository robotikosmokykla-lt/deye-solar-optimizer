# Synthetic demo configuration. Contains no credentials and points at a generated
# database, so `dashboard_server.py --env tools/demo.env` can be run by anyone.
DEYE_APP_ID="DEMO"
DEYE_APP_SECRET="DEMO"
DEYE_LOGIN="demo@example.com"
DEYE_PASSWORD="DEMO"
DEYE_INVERTER_SN="DEMO0000000000"

SITE_LATITUDE=52.10
SITE_LONGITUDE=5.18
SITE_TIMEZONE="Europe/Amsterdam"

BATTERY_EFFECTIVE_KWH=15.0
BATTERY_SOC_FLOOR_PCT=15.0
BATTERY_DAY_TARGET_SOC_PCT=96.0

GRID_EXPORT_HARD_LIMIT_W=1000
GRID_DAY_EXPORT_W=1000

LOAD_BASE_HOUSE_W=120
LOAD_SYSTEM_OVERHEAD_W=130

PV_PERFORMANCE_RATIO=0.82
PV_ARRAYS_JSON='[{"name":"south_roof","kwp":10.0,"tilt_deg":35,"azimuth_deg":0}]'

WATER_HEATER_ENABLED=true
WATER_HEATER_TIME="09:00"
WATER_HEATER_POWER_W=2000
WATER_HEATER_DURATION_MINUTES=60
WATER_HEATER_ENERGY_KWH=2.0

ECONOMIC_IMPORT_EUR_KWH=0.28
ECONOMIC_EXPORT_EUR_KWH=0.07
ECONOMIC_BATTERY_WEAR_EUR_KWH=0.03

ANALYTICS_ENABLED=true
ANALYTICS_BIND="127.0.0.1"
ANALYTICS_PORT=8850
ANALYTICS_HISTORY_DAYS=30

LOGGING_STATE_DB="/tmp/deye-demo/state.db"
LOGGING_JSONL="/tmp/deye-demo/events.jsonl"
CONTROL_LOOP_SECONDS=900
